# Range image only (ADR 0026, point 5): the pinned litewitness (range/witness) stands in for the Pi's, in the
# Pi's namespace (ADR 0032). It trusts the range ledger's key for its origin and listens on the Pi's end of the
# tunnel, for the relay and for the Pi's watcher beside it.
[Unit]
Description=Balistid Blue range: litewitness
Requires=balistid-range-witness-agent.service balistid-range-pi-net.service
After=balistid-range-witness-agent.service balistid-range-pi-net.service

[Service]
DynamicUser=yes
User=balistid-range-witness
StateDirectory=balistid-range-witness
EnvironmentFile=/etc/balistid-range/witness.env
ExecStartPre=/usr/lib/balistid-range/witnessctl add-log -db %S/balistid-range-witness/witness.db -origin balistid-range/log
ExecStartPre=/usr/lib/balistid-range/witnessctl add-key -db %S/balistid-range-witness/witness.db -origin balistid-range/log -key ${LEDGER_VKEY}
ExecStart=/usr/lib/balistid-range/litewitness -name balistid-range/witness -db %S/balistid-range-witness/witness.db \
  -ssh-agent /run/balistid-range-witness/agent.sock -key ${WITNESS_KEY} -listen 10.207.57.2:7380
NetworkNamespacePath=/run/netns/balistid-pi
IPAddressAllow=10.207.57.1 10.207.57.2
IPAddressDeny=any
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
