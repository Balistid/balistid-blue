# Started by systemd.wants= on the kernel command line (range/mkosi.conf). The VM powers off when
# the report is written or fails, so QEMU exits and the host reads the results disk (ADR 0009).
[Unit]
Description=Balistid Blue range guest report
Requires=dev-disk-by\x2did-virtio\x2dbalistid\x2dresults.device
After=dev-disk-by\x2did-virtio\x2dbalistid\x2dresults.device auditd.service audit-rules.service
After=systemd-sysctl.service
# The collector the guest reads its records from (ADR 0022); a collector that did not start shows in them.
After=balistid-collector.service
# The ledger the guest checks the collector's stream in (ADR 0027).
After=balistid-ledger.service
SuccessAction=poweroff-force
FailureAction=poweroff-force

[Service]
Type=oneshot
# A trial's name and boot phase, which the host passes over fw_cfg (ADR 0018, point 1).
ImportCredential=balistid.*
ExecStart=/usr/lib/balistid-range/guest
StandardOutput=journal+console
StandardError=journal+console
