# Judges the host's recording days from the collector's sealed store (ADR 0074). Started by hand, no timer and
# no [Install]: it runs as the collector's uid with no network, the store read-only and its results in its own
# state directory. Not in CPUUnits: it is no cost of recording.
[Unit]
Description=Balistid Blue judge: the recording days from the sealed store

[Service]
Type=oneshot
User=balistid-collector
Group=balistid-collector
ExecStart=/usr/local/lib/balistid/balistid-judge
# Results are world-readable whole files; the store itself stays the collector's 0700 directory.
StateDirectory=balistid/judge
StateDirectoryMode=0755
ReadOnlyPaths=/var/lib/balistid/collector
UMask=0022
# A shard of up to 512 MiB is copied into the unit's own tmpfs /tmp, and the judge's heap beside it. No swap.
MemoryMax=1536M
MemorySwapMax=0
# Beside the recorder, not over it: the oneshot has no start timeout by default, and a full read takes a while.
TimeoutStartSec=2h
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoExecPaths=/ /var/lib/balistid/judge /tmp /var/tmp -/dev/shm
ExecPaths=/usr/local/lib/balistid/balistid-judge
InaccessiblePaths=/var/log/audit
PrivateNetwork=yes
# It runs as the collector's uid: its own PID namespace keeps /proc/<pid>/root and kill away from the collector.
PrivatePIDs=yes
RestrictAddressFamilies=none
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
# A new tmpfs, so a shard copy never lands on the store's device.
PrivateTmp=disconnected
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring memfd_create execveat process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM
