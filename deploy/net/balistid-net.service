# Loads the host's firewall for the Pi, then brings up the WireGuard tunnel to it (ADR 0006 point 2, ADR 0032).
# A line runs only when the one before it succeeded, so the tunnel never exists without the table.
[Unit]
Description=Balistid Blue net: the relay-only firewall and the tunnel to the Pi
DefaultDependencies=no
# After a distribution's firewall, whose ruleset may flush this table when it loads (ordering only).
After=local-fs.target systemd-sysusers.service nftables.service firewalld.service
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=balistid-net
Group=balistid-net
# Netlink for nft, ip and wg: the one capability, never root (ADR 0032, R13).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# BALISTID_PI_ENDPOINT, the Pi's LAN IPv4 address, and BALISTID_PI_KEY, its WireGuard public key (install).
EnvironmentFile=/etc/balistid/net.env
# The host's WireGuard key, root's 0600 file, reaches wg only in the credential directory.
LoadCredential=wg-key:/etc/balistid/wg-key
ExecStart=/usr/bin/nft -D PI_ENDPOINT=${BALISTID_PI_ENDPOINT} -f /usr/local/lib/balistid/nftables.conf
ExecStart=/usr/bin/ip link add balistid0 type wireguard
ExecStart=/usr/bin/wg set balistid0 listen-port 51820 fwmark 0x4a1d private-key %d/wg-key peer ${BALISTID_PI_KEY} allowed-ips 10.207.57.2/32 endpoint ${BALISTID_PI_ENDPOINT}:51820
ExecStart=/usr/bin/ip address add 10.207.57.1 peer 10.207.57.2 dev balistid0
ExecStart=/usr/bin/ip link set balistid0 up
# Also after a start that failed half way; the table stays, its drops are safe without the tunnel.
ExecStopPost=-/usr/bin/ip link delete balistid0
# wg prints a key file it cannot parse, the whole key: nothing the unit's programs print reaches the journal.
StandardOutput=null
StandardError=null
UMask=0077
NoExecPaths=/ /tmp -/dev/shm
ExecPaths=/usr/bin/nft /usr/bin/ip /usr/bin/wg /usr/lib
# No IPAddressDeny: the tunnel's UDP socket is made in this unit's cgroup, whose filter would drop it.
RestrictAddressFamilies=AF_NETLINK AF_UNIX
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring memfd_create execveat process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM

[Install]
WantedBy=sysinit.target
