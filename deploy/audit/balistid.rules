## Balistid Blue floor-0 audit rules (ADR 0004). Installed only by balistid-install.
## version: adr-0004-v3 (the collector's -rule-version names it in its started record)
## -f 1 logs a failure instead of panicking; -r 0 so no rate limit drops records at the kernel. The
## backlog is a starting value; step 9.3 measures burst_rate against it. -c loads every line it can, so a line that
## fails (a missing tree) still ends with -e 2 and reads rules-differ (ADR 0059, 0061).
-D
-c
-b 65536
--backlog_wait_time 60000
-f 1
-r 0

## Exec records, and the usual ways around them: another process's memory or file handles, an anonymous file.
-a always,exit -F arch=b64 -S execve,execveat -k balistid-exec
-a always,exit -F arch=b32 -S execve,execveat -k balistid-exec
-a always,exit -F arch=b64 -S ptrace,process_vm_writev,pidfd_getfd -k balistid-inject
-a always,exit -F arch=b32 -S ptrace,process_vm_writev,pidfd_getfd -k balistid-inject
-a always,exit -F arch=b64 -S memfd_create -k balistid-memfd
-a always,exit -F arch=b32 -S memfd_create -k balistid-memfd

## The collector's canary creates c-<n> here; its record proves the path to the store (ADR 0017, point 2).
-w /var/lib/balistid/collector/canary -p w -k balistid-canary

## Root covering its tracks (ADR 0061). The syscall list takes its first matching rule, so a never rule stands just
## before what it leaves out; watches of a path are a list of their own that the kernel checks after it.
## Kernel modules, kexec, eBPF and mounts; systemd (pid 1) attaches cgroup programs at every unit start. audit's i386
## table names kexec_load sys_kexec_load; i386 has no kexec_file_load.
-a never,exit -F arch=b64 -S bpf -F pid=1
-a never,exit -F arch=b32 -S bpf -F pid=1
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module,kexec_load,kexec_file_load,bpf -k balistid-kernel
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module,sys_kexec_load,bpf -k balistid-kernel
-a always,exit -F arch=b64 -S mount,umount2,move_mount,fsmount,mount_setattr,open_tree -k balistid-kernel
-a always,exit -F arch=b32 -S mount,umount2,move_mount,fsmount,mount_setattr,open_tree -k balistid-kernel
## io_uring is disabled (deploy/sysctl); one that root re-enabled is recorded when set up, and its file ops.
-a always,exit -F arch=b64 -S io_uring_setup,io_uring_register -k balistid-uring
-a always,exit -F arch=b32 -S io_uring_setup,io_uring_register -k balistid-uring
-a always,io_uring -S openat,openat2,unlinkat,renameat,linkat,symlinkat,mkdirat,ftruncate -k balistid-uring
## Writes and removals under the journal, audit, Laurel and unit config, our programs and our state, by any program
## but a tree's owner as systemd starts it (ppid 1). perm=wa reads only an open's access mode, so an open that
## creates or truncates (O_CREAT|O_TRUNC, 0x240) gets its own rule; systemd reads its units with openat2. 32-bit
## programs are rare here: their creating opens anywhere under /etc and every open in the journal and our state.
-a never,exit -F arch=b64 -S openat2 -F pid=1
-a never,exit -F arch=b32 -S openat2 -F pid=1
-a always,exit -F dir=/etc/audit -F perm=wa -k balistid-config
-a always,exit -F dir=/etc/systemd -F perm=wa -k balistid-config
-a always,exit -F dir=/etc/laurel -F perm=wa -k balistid-config
-a always,exit -F dir=/usr/local/lib/balistid -F perm=wa -k balistid-config
-a always,exit -F path=/usr/lib/systemd/systemd-journald -F perm=wa -k balistid-config
-a always,exit -F dir=/var/log/journal -F perm=wa -k balistid-logs
-a always,exit -F dir=/var/lib/balistid -F perm=wa -k balistid-state
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b64 -S openat2 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b64 -S openat2 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/etc -k balistid-config
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/etc -k balistid-config
-a always,exit -F arch=b32 -S openat2 -F dir=/etc -k balistid-config
-a always,exit -F arch=b32 -S open,openat,openat2 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b32 -S open,openat,openat2 -F dir=/var/lib/balistid -k balistid-state

## Last: no rule or state change until reboot.
-e 2
