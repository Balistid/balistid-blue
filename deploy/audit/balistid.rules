## Balistid Blue floor-0 audit rules (ADR 0004). Installed only by balistid-install.
## version: adr-0004-v3 (the collector's -rule-version names it in its started record)
## -f 1 logs a failure instead of panicking; -r 0 so no rate limit drops records at the kernel. The
## backlog is a starting value; step 9.3 measures burst_rate against it. -c loads every line it can, so a line that
## fails (a missing tree) still ends with -e 2 and reads rules-differ (ADR 0059, 0061).
-D
-c
-b 65536
--backlog_wait_time 60000
-f 1
-r 0

## Exec records, and the usual ways around them: another process's memory or file handles, an anonymous file.
-a always,exit -F arch=b64 -S execve,execveat -k balistid-exec
-a always,exit -F arch=b32 -S execve,execveat -k balistid-exec
-a always,exit -F arch=b64 -S ptrace,process_vm_writev,pidfd_getfd -k balistid-inject
-a always,exit -F arch=b32 -S ptrace,process_vm_writev,pidfd_getfd -k balistid-inject
-a always,exit -F arch=b64 -S memfd_create -k balistid-memfd
-a always,exit -F arch=b32 -S memfd_create -k balistid-memfd

## The collector's canary creates c-<n> here; its record proves the path to the store (ADR 0017, point 2).
-w /var/lib/balistid/collector/canary -p w -k balistid-canary

## Root covering its tracks (ADR 0061). The syscall list takes its first matching rule, so a never rule stands just
## before what it leaves out; watches of a path are a list of their own that the kernel checks after it.
## Kernel modules, kexec and eBPF; systemd (pid 1) attaches cgroup programs at every unit start. audit's i386 table
## names kexec_load sys_kexec_load; i386 has no kexec_file_load.
-a never,exit -F arch=b64 -S bpf -F pid=1
-a never,exit -F arch=b32 -S bpf -F pid=1
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module,kexec_load,kexec_file_load,bpf -k balistid-kernel
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module,sys_kexec_load,bpf -k balistid-kernel
## Borrowed identity or capabilities, which would pass the never rules and the mounts' euid=0 below: an exe taken
## over (PR_SET_MM, 35), capabilities kept across a uid change (PR_SET_SECUREBITS, 28; PR_SET_KEEPCAPS, 8).
-a always,exit -F arch=b64 -S prctl -F a0=35 -k balistid-inject
-a always,exit -F arch=b32 -S prctl -F a0=35 -k balistid-inject
-a always,exit -F arch=b64 -S prctl -F a0=28 -k balistid-inject
-a always,exit -F arch=b32 -S prctl -F a0=28 -k balistid-inject
-a always,exit -F arch=b64 -S prctl -F a0=8 -k balistid-inject
-a always,exit -F arch=b32 -S prctl -F a0=8 -k balistid-inject
## Mounts by root: an unprivileged sandbox mounts hundreds of times in its own namespace, which hides nothing.
-a always,exit -F arch=b64 -S mount,umount2,move_mount,fsmount,fsconfig,fspick,mount_setattr,open_tree,open_tree_attr -F euid=0 -k balistid-kernel
-a always,exit -F arch=b32 -S mount,umount,umount2,move_mount,fsmount,fsconfig,fspick,mount_setattr,open_tree,open_tree_attr -F euid=0 -k balistid-kernel
## An open by handle carries no path a tree sees: every one that writes, creates or truncates (0x243), anywhere.
-a always,exit -F arch=b64 -S open_by_handle_at -F a2&0x243 -k balistid-handle
-a always,exit -F arch=b32 -S open_by_handle_at -F a2&0x243 -k balistid-handle
## io_uring is disabled (deploy/sysctl); one that root re-enabled is recorded when set up, and its path and
## allocation ops (audit skips its reads and writes).
-a always,exit -F arch=b64 -S io_uring_setup,io_uring_register -k balistid-uring
-a always,exit -F arch=b32 -S io_uring_setup,io_uring_register -k balistid-uring
-a always,io_uring -S openat,openat2,unlinkat,renameat,linkat,symlinkat,mkdirat,ftruncate,fallocate -k balistid-uring
## Trees: every write, removal, attribute change, and open that creates or truncates (O_CREAT|O_TRUNC, 0x240: perm=wa
## reads only the access mode), for both ABIs; openat2's flags no rule reads, so it is recorded whole, but pid 1's.
## Left out of the trees: the ledger, relay and runner (static binaries whose units write only their own directory,
## ProtectSystem=strict; the ledger alone about 4 records a second in the range). Their execs are recorded above.
-a never,exit -F arch=b64 -S openat2 -F pid=1
-a never,exit -F arch=b32 -S openat2 -F pid=1
-a never,exit -F exe=/usr/local/lib/balistid/balistid-ledger
-a never,exit -F exe=/usr/local/lib/balistid/balistid-relay
-a never,exit -F exe=/usr/local/lib/balistid/balistid-runner
-a always,exit -F dir=/etc/audit -F perm=wa -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/etc/audit -k balistid-config
-a always,exit -F arch=b32 -S openat2 -F dir=/etc/audit -k balistid-config
-a always,exit -F dir=/etc/systemd -F perm=wa -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/etc/systemd -k balistid-config
-a always,exit -F arch=b32 -S openat2 -F dir=/etc/systemd -k balistid-config
-a always,exit -F dir=/etc/laurel -F perm=wa -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/etc/laurel -k balistid-config
-a always,exit -F arch=b32 -S openat2 -F dir=/etc/laurel -k balistid-config
-a always,exit -F dir=/usr/local/lib/balistid -F perm=wa -k balistid-config
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F arch=b64 -S openat2 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F arch=b32 -S openat2 -F dir=/usr/local/lib/balistid -k balistid-config
-a always,exit -F dir=/var/log/journal -F perm=wa -k balistid-logs
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b64 -S openat2 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F arch=b32 -S openat2 -F dir=/var/log/journal -k balistid-logs
-a always,exit -F dir=/var/lib/balistid -F perm=wa -k balistid-state
-a always,exit -F arch=b64 -S open -F a1&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b64 -S openat -F a2&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b64 -S openat2 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b32 -S open -F a1&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b32 -S openat -F a2&0x240 -F dir=/var/lib/balistid -k balistid-state
-a always,exit -F arch=b32 -S openat2 -F dir=/var/lib/balistid -k balistid-state
## The sensor's and journald's binaries: any call on them, so no open mode empties them unrecorded.
-a always,exit -F path=/usr/lib/systemd/systemd-journald -k balistid-config
-a always,exit -F path=/usr/bin/auditd -k balistid-config
-a always,exit -F path=/usr/bin/laurel -k balistid-config

## Last: no rule or state change until reboot.
-e 2
